{
 "_doc": "Fill and save as plan.json. Every ref must be a library key; evidence ids come from evidence.md / irw.py find.",
 "language": "zh",
 "style": "gbt7714",
 "groups": [
  {
   "id": "g1",
   "name": "<route / problem setting>",
   "basis": "problem|method|data|evaluation",
   "dimension": "<the axis on which works in this group are compared>",
   "refs": [
    "ioffe2015",
    "simonyan2015"
   ],
   "comparison": "<how they differ / trade-off on that axis>",
   "evidence": [
    {
     "ref": "ioffe2015",
     "id": "E:<key>:p<page>:<n>",
     "use": "result|method|setting|limitation"
    }
   ]
  }
 ],
 "gaps": [
  {
   "id": "gap1",
   "statement": "<gap in one sentence>",
   "type": "common_limitation|uncovered_setting|conflict",
   "from": [
    {
     "ref": "ioffe2015",
     "id": "E:<key>:p<page>:<n>"
    }
   ],
   "author_judgment": false
  }
 ],
 "contributions": [
  {
   "id": "k1",
   "text": "<contribution as written in the draft>",
   "gaps": [
    "gap1"
   ],
   "evidence": [
    {
     "id": "E:self:p<page>:<n>"
    },
    {
     "loc": "Table 1",
     "quote": "<words from own paper>"
    }
   ]
  }
 ],
 "omitted_refs": {
  "<key>": "<why not cited>"
 }
}